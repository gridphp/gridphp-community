# Kept in the installed package when used as a dependency
# (export-ignore only applies to dependency installs, never to
# `composer create-project` - that always gets the full repo, including
# composer_script.php, since post-create-project-cmd needs it present):
/lib export-ignore=false
/composer.json export-ignore=false
/LICENSE export-ignore=false

# Excluded when used as a dependency:
/docs export-ignore
/demos export-ignore
/templates export-ignore
/bootstrap export-ignore
/tests export-ignore
/.github export-ignore
/config.sample.php export-ignore
/composer_script.php export-ignore
/README.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore